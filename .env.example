# ==============================================================================
# RESTOLINK - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
# CARA PENGGUNAAN:
# 1. Duplikasi file ini menjadi file baru bernama `.env` di root direktori:
#    cp .env.example .env
# 2. Isi nilai-nilai di bawah ini sesuai dashboard layanan masing-masing.
# 3. File `.env` bersifat RAHASIA dan tidak boleh di-commit ke Git repo.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Client Browser / Frontend)
# ------------------------------------------------------------------------------
# Didapat dari: Dashboard Supabase -> Project Settings -> API
# - VITE_SUPABASE_URL     : URL project Supabase (contoh: https://xyzcompany.supabase.co)
# - VITE_SUPABASE_ANON_KEY: Kunci publik "anon/public" (aman diakses browser via RLS)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ------------------------------------------------------------------------------
# 2. SUPABASE (Serverless API / Backend - RAHASIA)
# ------------------------------------------------------------------------------
# Didapat dari: Dashboard Supabase -> Project Settings -> API
# - SUPABASE_URL             : Sama dengan URL di atas
# - SUPABASE_SERVICE_ROLE_KEY: Kunci "service_role" (bypass RLS, HANYA untuk backend/webhook)
# PERINGATAN: JANGAN beri awalan VITE_ pada service role key agar tidak bocor ke browser!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ------------------------------------------------------------------------------
# 3. MIDTRANS PAYMENT GATEWAY (Serverless API / Backend - RAHASIA)
# ------------------------------------------------------------------------------
# Didapat dari: Dashboard Midtrans (Sandbox / Production) -> Settings -> Access Keys
# - MIDTRANS_SERVER_KEY    : Server Key akun Midtrans (contoh: SB-Mid-server-xxxx)
# - MIDTRANS_IS_PRODUCTION : 'false' untuk mode Sandbox testing, 'true' jika sudah Live
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE R2 OBJECT STORAGE (Serverless API / Backend - RAHASIA)
# ------------------------------------------------------------------------------
# Didapat dari: Cloudflare Dashboard -> R2 Object Storage
# - R2_ACCOUNT_ID        : Account ID Cloudflare (ada di sidebar dashboard)
# - R2_ACCESS_KEY_ID     : Buat di "Manage R2 API Tokens"
# - R2_SECRET_ACCESS_KEY : Secret Key dari token R2 yang dibuat
# - R2_BUCKET            : Nama bucket tempat menyimpan foto menu & logo (contoh: restolink-assets)
# - R2_PUBLIC_BASE_URL   : Domain publik bucket R2 atau r2.dev URL (contoh: https://assets.restolink.site)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=restolink-assets
R2_PUBLIC_BASE_URL=https://pub-xxxxxx.r2.dev

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI (Serverless API / Backend - RAHASIA)
# ------------------------------------------------------------------------------
# Didapat dari: Google AI Studio (https://aistudio.google.com/) -> Get API Key
# - Digunakan hanya untuk chatbot landing page utama platform
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
